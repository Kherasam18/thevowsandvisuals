# Admin sign-in.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored: these values
# must never be committed, because anything that reaches git history stays
# there even after it is deleted.
#
# Generate the two secret lines with:
#   npm run admin:password -- "your-password"

ADMIN_EMAIL=you@example.com

# scrypt hash of the password — not the password itself.
ADMIN_PASSWORD_HASH=

# Signs session cookies. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Set to true once the admin is served over https, so the session cookie
# never travels over a plain connection.
ADMIN_SECURE_COOKIES=false

# Set to /admin on the admin host, so the bare subdomain opens the dashboard
# instead of the public site. Leave blank locally, where this same server is
# used to preview the public build.
ADMIN_ROOT_REDIRECT=


# ---------------------------------------------------------------------------
# Cloudflare R2. Leave blank to keep using the local .data folder.
# ---------------------------------------------------------------------------
# R2 → Overview → Account ID (also the first part of the S3 endpoint).
R2_ACCOUNT_ID=

# R2 → Manage API Tokens → Create. Needs "Object Read & Write" on both buckets.
# The secret is shown once, at creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Served over the media custom domain: display copies and the content document.
R2_BUCKET=vows-media

# Never public: the untouched master uploads.
R2_BUCKET_ORIGINALS=vows-originals


# ---------------------------------------------------------------------------
# Where the public site reads media from. This one IS compiled into the
# browser bundle, hence the VITE_ prefix — it is a public URL, not a secret.
# Blank means same-origin, which is what local development uses.
# ---------------------------------------------------------------------------
VITE_MEDIA_BASE=

# Where the admin actually runs. Set this ONLY on the public deployment, so
# /admin there redirects to the host that has the API behind it. Leave blank
# locally and on the admin host itself, or it would redirect to itself.
VITE_ADMIN_URL=
